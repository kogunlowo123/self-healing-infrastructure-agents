{
  "$defs": {
    "ActionKind": {
      "description": "Remediation actions. Values double as policy actions and fabric scopes.",
      "enum": [
        "k8s:restart",
        "k8s:scale",
        "k8s:rollout-undo",
        "k8s:cordon",
        "k8s:uncordon",
        "terraform:apply"
      ],
      "title": "ActionKind",
      "type": "string"
    },
    "ActionSpec": {
      "additionalProperties": false,
      "description": "What to do, to what, and why.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ActionKind"
        },
        "plan_file": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "terraform:apply only; saved plan file",
          "title": "Plan File"
        },
        "reason": {
          "maxLength": 2000,
          "minLength": 3,
          "title": "Reason",
          "type": "string"
        },
        "replicas": {
          "anyOf": [
            {
              "maximum": 1000,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "k8s:scale only",
          "title": "Replicas"
        },
        "rollback_stack": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "terraform:apply only; stack directory holding the last-known-good configuration (same backend). If the post-check fails it is planned fresh and applied only when that plan is non-destructive",
          "title": "Rollback Stack"
        },
        "target": {
          "$ref": "#/$defs/Target"
        }
      },
      "required": [
        "kind",
        "target",
        "reason"
      ],
      "title": "ActionSpec",
      "type": "object"
    },
    "Alert": {
      "description": "A source-neutral alert. ``fingerprint`` groups repeats into one incident.",
      "properties": {
        "annotations": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Annotations",
          "type": "object"
        },
        "description": {
          "default": "",
          "maxLength": 8000,
          "title": "Description",
          "type": "string"
        },
        "ends_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ends At"
        },
        "fingerprint": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Fingerprint",
          "type": "string"
        },
        "labels": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Labels",
          "type": "object"
        },
        "name": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "payload_digest": {
          "description": "sha256 of the raw notification this alert came from",
          "title": "Payload Digest",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        },
        "source": {
          "$ref": "#/$defs/AlertSource"
        },
        "starts_at": {
          "format": "date-time",
          "title": "Starts At",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/AlertStatus"
        },
        "summary": {
          "default": "",
          "maxLength": 2000,
          "title": "Summary",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "$ref": "#/$defs/Target"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "source",
        "fingerprint",
        "name",
        "status",
        "severity",
        "starts_at",
        "payload_digest",
        "received_at"
      ],
      "title": "Alert",
      "type": "object"
    },
    "AlertSource": {
      "enum": [
        "alertmanager",
        "cloudwatch"
      ],
      "title": "AlertSource",
      "type": "string"
    },
    "AlertStatus": {
      "enum": [
        "firing",
        "resolved"
      ],
      "title": "AlertStatus",
      "type": "string"
    },
    "Diagnosis": {
      "properties": {
        "escalate": {
          "description": "True when a human must take over",
          "title": "Escalate",
          "type": "boolean"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "hypotheses": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Hypothesis"
          },
          "title": "Hypotheses",
          "type": "array"
        },
        "narrative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Advisory model-written summary; never drives actions",
          "title": "Narrative"
        },
        "playbook_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Playbook Id"
        },
        "playbook_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Playbook Version"
        },
        "selected": {
          "anyOf": [
            {
              "$ref": "#/$defs/Hypothesis"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        }
      },
      "required": [
        "playbook_id",
        "playbook_version",
        "evidence",
        "summary",
        "escalate"
      ],
      "title": "Diagnosis",
      "type": "object"
    },
    "Evidence": {
      "description": "Facts gathered read-only from the environment, plus what could not be gathered.",
      "properties": {
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "errors": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "facts": {
          "additionalProperties": true,
          "title": "Facts",
          "type": "object"
        },
        "observations": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Observations",
          "type": "array"
        }
      },
      "required": [
        "collected_at"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "Hypothesis": {
      "properties": {
        "action": {
          "anyOf": [
            {
              "$ref": "#/$defs/ActionSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "rationale": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rationale",
          "type": "array"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "confidence"
      ],
      "title": "Hypothesis",
      "type": "object"
    },
    "IncidentStatus": {
      "enum": [
        "open",
        "diagnosed",
        "remediating",
        "escalated",
        "resolved"
      ],
      "title": "IncidentStatus",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "critical"
      ],
      "title": "Severity",
      "type": "string"
    },
    "Target": {
      "additionalProperties": false,
      "description": "The infrastructure object an alert is about and a remediation acts on.",
      "properties": {
        "cluster": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cluster"
        },
        "environment": {
          "default": "production",
          "maxLength": 40,
          "minLength": 1,
          "title": "Environment",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TargetKind"
        },
        "name": {
          "maxLength": 253,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "namespace": {
          "anyOf": [
            {
              "maxLength": 63,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Namespace"
        }
      },
      "required": [
        "kind",
        "name"
      ],
      "title": "Target",
      "type": "object"
    },
    "TargetKind": {
      "enum": [
        "deployment",
        "node",
        "terraform_stack",
        "cloud_resource"
      ],
      "title": "TargetKind",
      "type": "string"
    }
  },
  "$id": "https://github.com/kogunlowo123/self-healing-infrastructure-agents/schemas/incident.response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "alerts": {
      "items": {
        "$ref": "#/$defs/Alert"
      },
      "minItems": 1,
      "title": "Alerts",
      "type": "array"
    },
    "diagnosis": {
      "anyOf": [
        {
          "$ref": "#/$defs/Diagnosis"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "fingerprint": {
      "title": "Fingerprint",
      "type": "string"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "occurrences": {
      "default": 1,
      "title": "Occurrences",
      "type": "integer"
    },
    "opened_at": {
      "format": "date-time",
      "title": "Opened At",
      "type": "string"
    },
    "plan_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Plan Ids",
      "type": "array"
    },
    "resolution": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolution"
    },
    "resolved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved At"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "status": {
      "$ref": "#/$defs/IncidentStatus"
    },
    "target": {
      "anyOf": [
        {
          "$ref": "#/$defs/Target"
        },
        {
          "type": "null"
        }
      ]
    },
    "title": {
      "title": "Title",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "default": 1,
      "title": "Version",
      "type": "integer"
    }
  },
  "required": [
    "fingerprint",
    "title",
    "severity",
    "status",
    "target",
    "alerts",
    "opened_at",
    "updated_at"
  ],
  "title": "Incident",
  "type": "object"
}
